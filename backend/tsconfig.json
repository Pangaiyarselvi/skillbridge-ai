{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "node",
      "express",
      "cors",
      "cookie-parser",
      "multer",
      "jsonwebtoken",
      "bcryptjs",
      "nodemailer",
      "pdf-parse"
    ]
  },
  "include": ["src/**/*"]
}