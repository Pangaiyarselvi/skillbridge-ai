# SkillBridge AI Backend — Environment Configuration
# Copy this file to .env and fill in the values

# ========== SERVER ==========
PORT=5000
NODE_ENV=production
APP_URL=https://skillbridge-ai-git-main-pangaiyarselvi.vercel.app

# ========== CORS & Frontend ==========
# IMPORTANT: Remove trailing slashes!
CORS_ORIGIN=https://skillbridge-ai-git-main-pangaiyarselvi.vercel.app

# ========== DATABASE (PostgreSQL) ==========
# Get this from your PostgreSQL provider (Render, Railway, Neon, etc.)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# ========== JWT SECRETS ==========
# Generate strong random secrets:
# Linux/Mac: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Windows: [System.Convert]::ToBase64String([System.Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes(32))
JWT_ACCESS_SECRET=your_strong_random_secret_here_min_32_chars
JWT_REFRESH_SECRET=another_strong_random_secret_here_min_32_chars

# ========== CLOUDINARY (Image Storage) ==========
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ========== EMAIL (SMTP) ==========
# Using Gmail? Use App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="SkillBridge AI <noreply@skillbridge.ai>"

# ========== AI (Groq API) ==========
# Free tier: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ========== OPTIONAL: HuggingFace (for embeddings) ==========
# Only needed if using LangChain vector store
# HUGGINGFACE_API_KEY=your_huggingface_token_here
