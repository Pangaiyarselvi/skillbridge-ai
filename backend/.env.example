# Server
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL, e.g. Supabase / Railway / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/skillbridge_ai?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SkillBridge AI <no-reply@skillbridge.ai>"

# AI (Groq + Llama 3.3)
GROQ_API_KEY=

# Embeddings (for LangChain vector search — HuggingFace Inference API)
HF_API_KEY=
